# dependencies
/node_modules
/.pnp
.pnp.js

# next.js — unanchored so nested build dirs (e.g. a stray sub-app) are caught too
.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# private / sensitive documents — never publish
*.pdf
# …except reports vetted for publication (no ID numbers, DOB, or contact details)
!/public/evidence/*.pdf
*FI Status*
/private/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Un-redacted medical reports — never commit; redact to images before shipping
/public/reports/*
# Vetted for publication (scores only; no ID, DOB, or contact details):
!/public/reports/hexaco.png
